# Neon connection string (Neon dashboard > Connect > pooled connection)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Random string, 32+ chars: run `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Your site URL (http://localhost:4321 locally, your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:4321
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TMDB v3 API key
TMDB_API_KEY=
# NVIDIA API key (build.nvidia.com, free tier) for Smart search
NVIDIA_API_KEY=
# Optional: model override (default nvidia/nemotron-3-ultra-550b-a55b)
NVIDIA_MODEL=
